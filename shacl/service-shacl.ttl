@prefix : <http://mee.foundation/ontologies/service/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix service: <http://mee.foundation/ontologies/service#> .
@prefix p: <http://mee.foundation/ontologies/persona#> .
@prefix o: <http://mee.foundation/ontologies/organization#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<http://mee.foundation/ontologies/service/shapes> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/service> ;
    owl:versionIRI <http://mee.foundation/ontologies/service/shapes/2.2.0> ;
    dc:date "2026-10-28"^^xsd:date ;
    rdfs:label "Service Ontology SHACL Validation Shapes"@en ;
    rdfs:comment "SHACL validation shapes for the Service Ontology."@en .


#################################################################
#  Service
#################################################################
#  The class-wide shape, constraining only what holds of every
#  service:Service regardless of kind. The per-kind shapes below
#  raise the same two paths to required exactly-one values where
#  their own kind demands it; none of them lowers a bound, so a
#  service typed as more than one kind (no class in service.ttl is
#  declared owl:disjointWith any other) still has a satisfiable set
#  of constraints. For the same reason no shape here asserts
#  sh:maxCount 0 on service:actsFor for service:ServiceProvider,
#  the one branch that doesn't use it — that would be unsatisfiable
#  against :AgentServiceShape's own sh:minCount 1 for any service
#  typed both an agent service and a provider.
#
#  service:ChatGPT gets no shape of its own: it adds no constraint
#  beyond the :LLMServiceShape it already inherits by
#  rdfs:subClassOf, and an empty shape would be noise. service:ArcaBackup gets one only because it additionally
#  requires service:providedBy. For the same no-lowered-bound reason,
#  :PodAgentShape asserts no sh:maxCount 0 on service:actsFor, though
#  a pod agent carries none.
#################################################################

:ServiceShape
    a sh:NodeShape ;
    sh:targetClass service:Service ;

    # service:providedBy — 0..1 on a service:Service generally, since a
    # service with no organization behind it simply omits it.
    sh:property [
        sh:path service:providedBy ;
        sh:maxCount 1 ;
        sh:class o:Organization ;
        sh:message "A service:Service may have at most one service:providedBy value, a single o:Organization."@en
    ] ;

    # service:actsFor — rdfs:domain is service:AgentService, so this class-wide
    # shape constrains only its cardinality and value type; the required
    # exactly-one lives on :AgentServiceShape below.
    sh:property [
        sh:path service:actsFor ;
        sh:maxCount 1 ;
        sh:class p:Person ;
        sh:message "A service:Service may have at most one service:actsFor value, a single p:Person."@en
    ] ;
    sh:message "Service validation."@en .


#################################################################
#  Agent Service
#################################################################

:AgentServiceShape
    a sh:NodeShape ;
    sh:targetClass service:AgentService ;

    # service:actsFor — required, exactly one value: an agent service is always
    # invited by, and acts on behalf of, exactly one person. Inherited by
    # service:ArcaBackup, which is why it needs no shape of its own for it.
    sh:property [
        sh:path service:actsFor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class p:Person ;
        sh:message "A service:AgentService must have exactly one service:actsFor value, a single p:Person."@en
    ] ;
    sh:message "Agent Service validation."@en .


#################################################################
#  Arca Backup
#################################################################

:ArcaBackupShape
    a sh:NodeShape ;
    sh:targetClass service:ArcaBackup ;

    # service:providedBy — required, exactly one value: a backup service is
    # always run by some organization. Its service:actsFor requirement comes
    # from :AgentServiceShape above, inherited rather than restated here.
    sh:property [
        sh:path service:providedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class o:Organization ;
        sh:message "A service:ArcaBackup must have exactly one service:providedBy value, a single o:Organization."@en
    ] ;
    sh:message "Arca Backup validation."@en .


#################################################################
#  Pod Agent
#################################################################

:PodAgentShape
    a sh:NodeShape ;
    sh:targetClass service:PodAgent ;

    # service:sponsoredBy — required, exactly one value: one member pays for
    # the agent. That the sponsor is a member of the same pod is checked by
    # integrity.md's YAML-11, since no single graph can show it.
    sh:property [
        sh:path service:sponsoredBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class p:Person ;
        sh:message "A service:PodAgent must have exactly one service:sponsoredBy value, a single p:Person."@en
    ] ;

    # service:viaGateway — required, exactly one value.
    sh:property [
        sh:path service:viaGateway ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class service:PodGateway ;
        sh:message "A service:PodAgent must have exactly one service:viaGateway value, a single service:PodGateway."@en
    ] ;

    # service:usesLLM — required, exactly one value.
    sh:property [
        sh:path service:usesLLM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class service:LLMService ;
        sh:message "A service:PodAgent must have exactly one service:usesLLM value, a single service:LLMService."@en
    ] ;
    sh:message "Pod Agent validation."@en .


#################################################################
#  Pod Gateway and LLM Service
#################################################################
#  service:hostedBy — optional, at most one value, a p:Person or an
#  o:Organization: whoever runs the software, often unknown to the pod.
#################################################################

:PodGatewayShape
    a sh:NodeShape ;
    sh:targetClass service:PodGateway ;
    sh:property [
        sh:path service:hostedBy ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class p:Person ] [ sh:class o:Organization ] ) ;
        sh:message "A service:PodGateway may have at most one service:hostedBy value, a single p:Person or o:Organization."@en
    ] ;
    sh:message "Pod Gateway validation."@en .

:LLMServiceShape
    a sh:NodeShape ;
    sh:targetClass service:LLMService ;
    sh:property [
        sh:path service:hostedBy ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class p:Person ] [ sh:class o:Organization ] ) ;
        sh:message "A service:LLMService may have at most one service:hostedBy value, a single p:Person or o:Organization."@en
    ] ;
    sh:message "LLM Service validation."@en .


#################################################################
#  Service Provider
#################################################################

:ServiceProviderShape
    a sh:NodeShape ;
    sh:targetClass service:ServiceProvider ;

    # service:providedBy — required, exactly one value: this class exists
    # precisely to be an organization's own service.
    sh:property [
        sh:path service:providedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class o:Organization ;
        sh:message "A service:ServiceProvider must have exactly one service:providedBy value, a single o:Organization."@en
    ] ;
    sh:message "Service Provider validation."@en .


#################################################################
#  Website Service
#################################################################
#  No sh:maxCount 0 on service:actsFor or service:providedBy, for the
#  reason the Service block above gives: a website service may also be
#  typed service:ServiceProvider once the organization behind it is
#  known, and lowering a bound here would make that unsatisfiable.
#################################################################

:WebsiteServiceShape
    a sh:NodeShape ;
    sh:targetClass service:WebsiteService ;

    # service:siteDomain — required, exactly one value: the key the app
    # matches a site on. Lowercase, two or more labels, ordinary order;
    # the label syntax is pod:tagNamespace's (shacl/pod-shacl.ttl), which
    # is symmetric, so the same pattern admits the normal-order form.
    sh:property [
        sh:path service:siteDomain ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" ;  # DNS domain, two or more lowercase labels
        sh:message "A service:WebsiteService must have exactly one service:siteDomain value, a lowercase DNS domain such as \"privo.com\"."@en
    ] ;
    sh:message "Website Service validation."@en .
