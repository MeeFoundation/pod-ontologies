@prefix service: <http://mee.foundation/ontologies/service#> .
@prefix p: <http://mee.foundation/ontologies/persona#> .
@prefix o: <http://mee.foundation/ontologies/organization#> .
@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/service> .

<http://mee.foundation/ontologies/service> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/service/2.12.0> ;
    dc:date "2026-10-28"^^xsd:date ;
    owl:versionInfo "Version 2.12.0 - added service:PodAgent, sponsored by one member and answering to every member, reaching its LLM (service:LLMService) through a gateway (service:PodGateway); service:ChatGPT is now an LLM service"@en ;
    owl:imports <https://w3id.org/cco-domains/cco/AgentOntology> ,
                <http://mee.foundation/ontologies/prov-upper-subset> ;
    rdfs:label "Service Ontology"@en ;
    rdfs:comment """Service Ontology for the Tellipod App.
                    Describes the non-human services a person invites to collaborate inside a
                    shared pod — the second kind of first-class, member-capable participant,
                    peer to persona.ttl (models Person). A service is not a service plus some
                    separate module wrapping it: every service the app offers is one of the
                    service:Service classes below, and every one of them is a service the app
                    can run. The file also defines the two pieces of software a
                    service:PodAgent reaches its language model through —
                    service:PodGateway and service:LLMService — which are deliberately not
                    service:Service subclasses, since neither ever joins a pod.
                    A pod's members are only ever
                    p:Person or service:Service individuals: o:Organization
                    (organization.ttl) is not itself member-capable, and reaches a pod only
                    as a tool's own pod:formTopic, as a pod:claimant, or as
                    service:providedBy's own range. A service:Service is never a pod:creator (pod.ttl) — and can
                    never be promoted to pod:owner either — only ever a pod:member
                    participant and a pod:claimant of the content it contributes.
                    p:Person/o:Organization (persona.ttl/organization.ttl) are referenced by
                    name without owl:imports, mirroring pod:claimant's own union-range
                    pattern. This file does carry two imports of its own: CCO's AgentOntology,
                    for the cco:ont00001017 (Agent) parent every service:Service specializes,
                    the same by-import pattern organization.ttl already uses for
                    cco:ont00001180 (Organization); and project_files/prov-upper.ttl (via
                    http://mee.foundation/ontologies/prov-upper-subset), a hand-curated subset
                    of the W3C PROV Ontology (PROV-O), since a service:Service is also a
                    real-world instance of prov:Agent, its software kinds
                    (service:AgentService, service:PodAgent, service:PodGateway,
                    service:LLMService) are prov:SoftwareAgent, and service:actsFor is a narrower case of PROV-O's
                    prov:actedOnBehalfOf delegation relation — see each term's own comment
                    below for the exact alignment triples."""@en .


#################################################################
#    Service
#################################################################

service:Service rdf:type owl:Class ;
    rdfs:subClassOf cco:ont00001017 ,  # CCO Agent (a Material Entity bearing an Agent Capability)
                    prov:Agent ;
    rdfs:label "Service"@en ;
    rdfs:comment """A software module that integrates some local or remote system into a pod, and in doing so becomes
                    a genuine non-human member of it — the member-capable class for every pod participant that is not
                    a person, the second kind of first-class, member-capable participant, peer to p:Person. A pod's
                    members are only ever p:Person or service:Service individuals; an o:Organization is not member-
                    capable, participating in a pod through the service:ServiceProvider it provides and otherwise
                    reaching it only as a pod:formTopic or a pod:claimant. Unlike p:Person, a service:Service is never a pod:creator,
                    and can never be promoted to pod:owner either — a pod is always created
                    by, and only ever owned by, a p:Person — but it can be a genuine
                    pod:member participant (see pod.ttl's pod:member comment) and a
                    pod:claimant of the graphs it contributes, including a tool's own graph
                    about whatever the pod's relationship concerns (e.g. a trip being
                    planned). Where an o:Organization stands behind the service in the
                    relationship, that organization claims on the service's behalf instead —
                    see pod:claimant's own comment for which of the two a graph names. Whatever it does outside the
                    pod, every service:Service reaches the pod itself through one surface — the Pod Interface, the
                    same read/write surface a human member's own UI uses (app-behavior.md), which is why an invited
                    service needs no special-case permission logic. It branches in four on the
                    question of whom the service acts for: service:AgentService acts on
                    behalf of exactly one p:Person member of the pod (service:actsFor),
                    service:PodAgent answers to every member of the pod alike, one member
                    paying for it (service:sponsoredBy), service:ServiceProvider acts on
                    behalf of the o:Organization that provides it (service:providedBy), and
                    service:WebsiteService stands for a website known only by its domain
                    (service:siteDomain), with no member or organization it is known to act
                    for. The concrete services the app ships are service:ArcaBackup, a leaf
                    under service:AgentService, and the pod agent, which reaches its language
                    model (e.g. service:ChatGPT) through a gateway. No class here
                    is declared owl:disjointWith any other, since one real service can
                    legitimately be more than one kind at once. rdfs:subClassOf cco:ont00001017 (CCO Agent,
                    "A Material Entity that bears an Agent Capability", itself a
                    BFO_0000040 Material Entity) — this is what grounds a service as a thing
                    that genuinely acts, which is exactly what a pod member has to be, and it
                    parallels o:Organization's own cco:ont00001180 (Organization) parent, so
                    every pod participant, human or service, is a CCO Agent. Also
                    rdfs:subClassOf prov:Agent (project_files/prov-upper.ttl) — every
                    service:Service individual bears responsibility for the claims it makes
                    inside a pod, which is what prov:Agent means; subClassOf rather than
                    owl:equivalentClass on both parents, since each one's own membership is
                    far broader than "invited to collaborate inside a shared pod.\""""@en .

service:providedBy rdf:type owl:ObjectProperty ;
    rdfs:domain service:Service ;
    rdfs:range o:Organization ;
    rdfs:label "provided by"@en ;
    rdfs:comment """Identifies the o:Organization that provides this service — e.g.
                    :Citibank_Service carries service:providedBy :Citibank, and :Arca_Backup
                    carries service:providedBy :Arca. At most one value on a service:Service
                    generally (0..1 — a service standing behind no organization at all, such
                    as an AI agent a person runs on their own device, simply omits it), and
                    required, exactly one value on service:ServiceProvider and
                    service:ArcaBackup specifically (1..1); all three cardinalities are
                    enforced by shacl/service-shacl.ttl. A service:PodAgent normally carries
                    none: whoever runs its gateway and its language model is recorded by
                    service:hostedBy on those, and is not a party to the pod's relationship.
                    This is the only route by which an
                    o:Organization reaches a pod's member list at all: the organization
                    itself is not member-capable, its service is. It is also what identifies
                    the party a provider service's claims are attributed to — see
                    pod:claimant's own comment. Range o:Organization (organization.ttl) is
                    referenced by name without owl:imports, the same by-name pattern
                    pod:creator/pod:claimant (both pod.ttl) already use."""@en .


#################################################################
#    Agent Service
#################################################################

service:AgentService rdf:type owl:Class ;
    rdfs:subClassOf service:Service ,
                    prov:SoftwareAgent ;
    rdfs:label "Agent Service"@en ;
    rdfs:comment """A service that acts on behalf of exactly one p:Person member of the pod,
                    named by its own required service:actsFor value — this is what defines the
                    class, not what the service happens to do with that mandate. A backup
                    service (service:ArcaBackup) is one: it was invited by one member, works
                    for that member, and answers to no one else in the pod. Contrast
                    service:PodAgent, which answers to every member, and
                    service:ServiceProvider, which acts for the o:Organization that provides
                    it, recorded by service:providedBy rather than service:actsFor.
                    Directly instantiable, not abstract: a member's agent that has no vendor
                    class of its own is typed service:AgentService and nothing more, so
                    modeling a new service never requires minting a class for it first.
                    Unlike a service:ServiceProvider, an agent service claims the graphs it
                    contributes under its own IRI rather than an organization's, since no
                    organization stands behind it in the pod's relationship — even where one
                    provides it (service:ArcaBackup carries service:providedBy :Arca and still
                    claims as itself). rdfs:subClassOf prov:SoftwareAgent
                    (project_files/prov-upper.ttl) alongside its service:Service parent, so
                    every leaf below inherits it: each is real software running on someone's
                    behalf, which is what prov:SoftwareAgent means; subClassOf rather than
                    owl:equivalentClass since prov:SoftwareAgent's own membership is broader
                    than "invited to collaborate inside a shared pod.\""""@en .

service:actsFor rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:actedOnBehalfOf ;
    rdfs:domain service:AgentService ;
    rdfs:range p:Person ;
    rdfs:label "acts for"@en ;
    rdfs:comment """Identifies the p:Person member this agent service is a
                    delegate/collaborator for — e.g. Alice's own backup service carries
                    service:actsFor :Self. Required, exactly one value: a
                    service:AgentService is always invited into a pod by, and acts on behalf
                    of, exactly one person, never independently — a second member who wants
                    their own agent invites a separate service:AgentService individual of
                    their own, with its own service:actsFor value. That one-principal rule is
                    also why a pod:serviceTag (pod.ttl) written by an agent service is
                    never propagated on a share: the tag means something only in the instance
                    of the member the service acts for. The range is p:Person alone, not the
                    wider member union: an agent's principal is always a human, mirroring
                    pod:creator's and pod:owner's own person-only ranges, and referenced by
                    name without owl:imports the same way they are. rdfs:subPropertyOf
                    prov:actedOnBehalfOf (project_files/prov-upper.ttl) — PROV-O's own
                    delegation relation, narrowed here to service:AgentService's own domain
                    and to p:Person's own range rather than PROV-O's broader prov:Agent on
                    both sides; a legal RDFS narrowing, not owl:equivalentProperty."""@en .


#################################################################
#    Arca Backup
#################################################################

service:ArcaBackup rdf:type owl:Class ;
    rdfs:subClassOf service:AgentService ;
    rdfs:label "Arca Backup"@en ;
    rdfs:comment """The pod backup service Arca provides, joining a pod as a real member with
                    its own self-claimed pod:member entry — e.g. :Arca_Backup, the second
                    member of Alice's Arca pod alongside her own. Inherits service:actsFor
                    from service:AgentService, required exactly once: a backup service backs
                    up on behalf of the member who invited it, and it is that member's copy of
                    the pod it preserves, which is why it has a single principal like any
                    other agent service. Carries service:providedBy as well, required exactly
                    once (1..1, shacl/service-shacl.ttl's :ArcaBackupShape), naming the
                    o:Organization that runs it, since the arrangement genuinely involves Arca
                    as well as the member. It still claims its own graphs under its own IRI
                    rather than Arca's, unlike a service:ServiceProvider."""@en .


#################################################################
#    Pod Agent
#################################################################

service:PodAgent rdf:type owl:Class ;
    rdfs:subClassOf service:Service ,
                    prov:SoftwareAgent ;
    rdfs:label "Pod Agent"@en ;
    rdfs:comment """An AI agent that joins a pod as a real member and answers to every member
                    of it alike — any member can address it in the pod's chat, and it can
                    contribute to the note and to a tool's graphs like any other member. One
                    member pays for it, named by its required service:sponsoredBy value, but
                    it does not act on that member's behalf: that is the whole of the
                    difference from a service:AgentService, whose service:actsFor names the
                    one member it works for. It carries no service:actsFor. Any owner can
                    remove it from the pod, as with any non-owner member. Its handle in the
                    pod's chat (e.g. "@ChatGPT") is its own rdfs:label.
                    A pod agent is the member-facing end of two pieces of software, neither of
                    which joins the pod: a gateway (service:viaGateway, a service:PodGateway)
                    that speaks the PDN/Tellipod protocols on one side and talks to a language
                    model on the other, and that language model itself (service:usesLLM, a
                    service:LLMService). Either can be hosted by a company or by an
                    individual, the sponsor included, which is why paying for them
                    (service:sponsoredBy) is recorded separately from running them
                    (service:hostedBy). Like a service:AgentService, it claims the graphs it
                    contributes under its own IRI, since no organization stands behind it in
                    the pod's relationship. rdfs:subClassOf prov:SoftwareAgent
                    (project_files/prov-upper.ttl) alongside its service:Service parent, since
                    it is real software; subClassOf rather than owl:equivalentClass since
                    prov:SoftwareAgent's own membership is far broader."""@en .

service:sponsoredBy rdf:type owl:ObjectProperty ;
    rdfs:domain service:PodAgent ;
    rdfs:range p:Person ;
    rdfs:label "sponsored by"@en ;
    rdfs:comment """Identifies the p:Person member who pays for this pod agent — for its gateway
                    and its language model — whoever hosts either one. Required, exactly one
                    value, and the sponsor is always a member of the same pod (integrity.md's
                    YAML-11, since no single graph can show it). The range is p:Person alone,
                    mirroring pod:creator's and pod:owner's own person-only ranges, referenced
                    by name without owl:imports the same way. Deliberately not an
                    rdfs:subPropertyOf prov:actedOnBehalfOf, unlike service:actsFor: a pod
                    agent answers to every member, not to the one who pays for it."""@en .

service:viaGateway rdf:type owl:ObjectProperty ;
    rdfs:domain service:PodAgent ;
    rdfs:range service:PodGateway ;
    rdfs:label "via gateway"@en ;
    rdfs:comment """The gateway this pod agent reaches its language model through. Required,
                    exactly one value."""@en .

service:usesLLM rdf:type owl:ObjectProperty ;
    rdfs:domain service:PodAgent ;
    rdfs:range service:LLMService ;
    rdfs:label "uses LLM"@en ;
    rdfs:comment """The language model that produces this pod agent's replies and
                    contributions. Required, exactly one value."""@en .


#################################################################
#    Pod Gateway and LLM Service
#################################################################

service:PodGateway rdf:type owl:Class ;
    rdfs:subClassOf cco:ont00001017 ,  # CCO Agent
                    prov:SoftwareAgent ;
    rdfs:label "Pod Gateway"@en ;
    rdfs:comment """Software that bridges the PDN/Tellipod protocols on one side to a language
                    model (a service:LLMService) on the other, so that a service:PodAgent can
                    take part in a pod. It receives the pod's content and the messages
                    addressed to the agent, calls the model, and writes the result back into
                    the pod as the agent. A company may host the gateway alone or together
                    with the model, and so may a technically inclined individual; who does is
                    recorded by service:hostedBy. Not a service:Service: it never joins a pod
                    itself, the service:PodAgent it serves being the member. Parented directly
                    on cco:ont00001017 (CCO Agent) and prov:SoftwareAgent instead, the same
                    two alignments service:Service and service:AgentService carry."""@en .

service:LLMService rdf:type owl:Class ;
    rdfs:subClassOf cco:ont00001017 ,  # CCO Agent
                    prov:SoftwareAgent ;
    rdfs:label "LLM Service"@en ;
    rdfs:comment """A large language model a service:PodAgent uses, reached through its
                    service:PodGateway. Directly instantiable: a model with no vendor class of
                    its own (e.g. one an individual hosts themselves) is typed
                    service:LLMService and nothing more. Who runs it is recorded by
                    service:hostedBy. Not a service:Service, for the same reason as
                    service:PodGateway: it never joins a pod."""@en .

service:hostedBy rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( service:PodGateway service:LLMService ) ] ;
    rdfs:range [ rdf:type owl:Class ;
                 owl:unionOf ( p:Person o:Organization ) ] ;
    rdfs:label "hosted by"@en ;
    rdfs:comment """The p:Person or o:Organization that runs this gateway or language model —
                    a company offering hosting, or an individual hosting it themselves, who may
                    also be the pod agent's sponsor. Optional, at most one value (0..1,
                    shacl/service-shacl.ttl): hosting is often unknown to the pod, and the
                    sponsor is what the pod depends on. Ranges referenced by name without
                    owl:imports, as elsewhere in this file."""@en .


#################################################################
#    ChatGPT
#################################################################

service:ChatGPT rdf:type owl:Class ;
    rdfs:subClassOf service:LLMService ;
    rdfs:label "ChatGPT"@en ;
    rdfs:comment """OpenAI's ChatGPT, as the language model behind a service:PodAgent — the
                    model, not the pod member: the member is the pod agent that uses it
                    (service:usesLLM), whose own rdfs:label is its handle in the pod's chat.
                    Carries no service:providedBy, since the class already names the vendor;
                    who runs a particular instance is recorded by service:hostedBy. See
                    app-behavior.md's ChatGPT Service section for what a pod agent does once
                    invited."""@en .


#################################################################
#    Service Provider
#################################################################

service:ServiceProvider rdf:type owl:Class ;
    rdfs:subClassOf service:Service ;
    rdfs:label "Service Provider"@en ;
    rdfs:comment """The service an o:Organization provides to a person, standing in for that
                    organization inside a shared pod — e.g. :Citibank_Service, the service
                    Citibank provides, which is Alice's Citibank pod's second member;
                    :BHS_Service does the same for the Boston Hub Society. Carries
                    service:providedBy, required exactly once (1..1,
                    shacl/service-shacl.ttl's :ServiceProviderShape), naming the providing
                    organization — this class exists precisely to be an organization's own
                    service, so that link is never absent. Carries no service:actsFor value — it is not a
                    service:AgentService: a provider service acts for the organization that
                    provides it, recorded by service:providedBy, not for any p:Person member
                    of the pod. That is the whole of the difference between the two branches. It is the
                    pod:subject, but not the pod:claimant, of the pod:member entry the
                    organization takes part through: the claims are attributed to the providing
                    o:Organization itself, since that is the party really making them and the
                    one an eventual cryptographic signature would name (see pod:claimant).
                    Not to be confused with CCO's own cco:ont00000509 ("Service Provider"),
                    which this file's imported CCO AgentOntology also defines and which shares
                    this class's rdfs:label: that one is a subclass of cco:ont00001180
                    (Organization) — "An Organization whose purpose is to provide a service to
                    other Agents" — i.e. the providing organization itself, the value on the
                    far end of this class's own service:providedBy. This class is the service
                    that organization provides, not the organization; the two sit on opposite
                    ends of one service:providedBy triple, and no alignment is asserted between
                    them, since aligning them would wrongly make every service an organization.
                    Left at its service:Service parent's cco:ont00001017/prov:Agent alignment
                    rather than narrowed to prov:SoftwareAgent (unlike service:AgentService
                    and every leaf beneath it), since what an organization provides need not
                    be running software at all."""@en .



#################################################################
#    Website Service
#################################################################

service:WebsiteService rdf:type owl:Class ;
    rdfs:subClassOf service:Service ;
    rdfs:label "Website Service"@en ;
    rdfs:comment """A website that issues a credential to the person (e.g. a W3C verifiable
                    credential or a KERI ACDC), or asks the person to present one, standing in
                    for that site as a member of the pod the credential is kept in — e.g. an
                    age-verification site that issues a credential, or a social network that
                    requires one. Carries service:siteDomain, required exactly once (1..1,
                    shacl/service-shacl.ttl's :WebsiteServiceShape): that domain is what the app
                    matches on to find the pod a site's credentials belong in, during a
                    credential issuance or presentation handled by the pod:Browser tool's
                    extension. A site takes part in its pod in one of two ways. Most do not
                    take part at all: the app mints the website service itself, knowing the
                    site by its domain and nothing else, and since the site never receives a
                    copy of the pod or writes to it, it claims nothing — its pod:member entry
                    is claimed by the person whose app minted it, with the service as that
                    entry's pod:subject. Such a service carries no service:actsFor (it acts for
                    no member) and no service:providedBy (a domain alone does not say which
                    o:Organization runs the site). A site that supports the Pod Interface
                    natively instead joins the pod and writes to it itself: its website
                    service is also typed service:ServiceProvider, carrying service:providedBy
                    the organization behind the site, and that organization claims the
                    member entry, as with every service:ServiceProvider. No class here is
                    disjoint with any other, so the two types sit together without conflict.
                    Either way the credentials themselves are pod attachments, kept exactly as
                    received, not claims in any graph. Left at its service:Service parent's
                    cco:ont00001017/prov:Agent alignment, as service:ServiceProvider is,
                    since a website is not known to be one piece of running software."""@en .

service:siteDomain rdf:type owl:DatatypeProperty ;
    rdfs:domain service:WebsiteService ;
    rdfs:range xsd:string ;
    rdfs:label "site domain"@en ;
    rdfs:comment """The DNS domain of the website a service:WebsiteService stands for, in
                    lowercase and in ordinary left-to-right order — e.g. "privo.com", never
                    "PRIVO.com" or reverse-DNS "com.privo" (contrast pod:tagNamespace, which
                    is reverse-DNS). Required, exactly one value. It is the key both
                    credential flows match on: the app finds the pod a site's credentials
                    belong in by looking for a member whose service:siteDomain equals the
                    site's own domain, and mints a new pod only when none has one. Named
                    siteDomain rather than domain so it cannot be misread as rdfs:domain."""@en .
